{
  "name": "pyb-attendance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev dist --compatibility-date=2024-09-23",
    "dev:frontend": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "db:create": "wrangler d1 create pyb-attendance-db",
    "db:migrate:local": "wrangler d1 migrations apply pyb-attendance-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply pyb-attendance-db --remote",
    "db:seed": "wrangler d1 execute pyb-attendance-db --file=sql/seed.sql --local",
    "db:seed:remote": "wrangler d1 execute pyb-attendance-db --file=sql/seed.sql --remote",
    "db:reset": "wrangler d1 execute pyb-attendance-db --file=sql/dev-reset.sql --local && npm run db:migrate:local && npm run db:seed",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "wrangler": "^3.78.0"
  }
}
